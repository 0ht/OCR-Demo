      "type": "string",
      "value": "[format('https://{0}', reference(resourceId('Microsoft.App/containerApps', format('ui-{0}', parameters('environmentName'))), '2024-03-01').configuration.ingress.fqdn)]"
    },
    "SERVICE_API_INTERNAL_ENDPOINT": {
      "type": "string",
      "value": "[format('https://{0}', reference(resourceId('Microsoft.App/containerApps', format('api-{0}', parameters('environmentName'))), '2024-03-01').configuration.ingress.fqdn)]"
