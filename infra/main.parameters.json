{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "apiImage": {
      "value": "${SERVICE_API_IMAGE_NAME}"
    },
    "uiImage": {
      "value": "${SERVICE_UI_IMAGE_NAME}"
    },
    "documentIntelligenceEndpoint": {
      "value": "${DOCUMENT_INTELLIGENCE_ENDPOINT}"
    },
    "documentIntelligenceKey": {
      "value": "${DOCUMENT_INTELLIGENCE_KEY}"
    },
    "contentUnderstandingEndpoint": {
      "value": "${CONTENT_UNDERSTANDING_ENDPOINT}"
    },
    "contentUnderstandingKey": {
      "value": "${CONTENT_UNDERSTANDING_KEY}"
    },
    "contentUnderstandingProject": {
      "value": "${CONTENT_UNDERSTANDING_PROJECT}"
    },
    "contentUnderstandingApiVersion": {
      "value": "${CONTENT_UNDERSTANDING_API_VERSION}"
    }
  }
}
